# Base
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*.log
logs/
tmp/
temp/
**/output/

# Real local configuration and secrets
.env
.env.*
!.env.example
settings.yaml
settings.local.yaml
config.local.yml

# Harness local auxiliary run surfaces
.agents/state/*
!.agents/state/TEMPLATE.md
.agents/runs/*
!.agents/runs/TEMPLATE.md

# Real task plans stay local; templates remain commit-safe.
.agents/plans/*.md
.agents/plans/**/*.md
!.agents/plans/TEMPLATE.md
!.agents/plans/EXAMPLE-implementation.md

# Cursor project rules are commit-safe; other Cursor files stay local by default.
.cursor/*
!.cursor/rules/
!.cursor/rules/*.mdc

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.out
coverage.html
# vendor/
go.work
bin/
build/

# Project-local manual test/output directories
/test/
/test*/
